        {
          "kind": "recv",
          "hex": "0000001000040000000000010000000000000004",
          "send": [],
          "events": []
        }
      ]
    },
    {
      "id": "concurrency-refused-stream-number-reuse-closes",
      "description": "동시 스트림 한도(1)에 걸려 RESET(REFUSED)로 거절한 요청의 번호(3)도 쓰인 것으로 센다. 상대가 그 번호로 새 요청을 다시 보내면 번호 역행이라 연결 오류이고, CLOSE(PROTOCOL_ERROR)를 보내고 닫는다. 대기 중인 요청 1은 상대가 연 스트림이라 result 이벤트가 없다",
      "spec": [
        "4.2.1",
        "4.5",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "local_hello": {
          "max_concurrent_streams": 1
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000000c010100000000000100000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 1,
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [
            {
              "type": "RESET",
              "stream_id": 3,
              "error_code": "REFUSED"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "PROTOCOL_ERROR"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    }
