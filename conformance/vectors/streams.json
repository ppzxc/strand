    {
      "id": "concurrency-refused-stream-number-reuse-closes",
      "description": "동시 스트림 한도(1)에 걸려 RESET(REFUSED)로 거절한 요청의 번호(3)도 쓰인 것으로 센다. 상대가 그 번호로 새 요청을 다시 보내면 번호 역행이라 연결 오류이고, CLOSE(PROTOCOL_ERROR)를 보내고 닫는다. 대기 중인 요청 1은 상대가 연 스트림이라 result 이벤트가 없다",
      "spec": [
        "4.2.1",
        "4.5",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "local_hello": {
          "max_concurrent_streams": 1
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000000c010100000000000100000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 1,
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [
            {
              "type": "RESET",
              "stream_id": 3,
              "error_code": "REFUSED"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "PROTOCOL_ERROR"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
    {
      "id": "exhaustion-after-last-number-sends-close-client",
      "description": "클라이언트 역할 구현의 다음 번호가 2^31-1이면 그 번호로 요청을 보낼 수 있다. 응답을 받은 뒤 다음 요청은 번호가 2^31-1을 넘으므로 프레임을 보내지 않고 로컬 UNAVAILABLE로 실패하고(stream_id 없음, result 이벤트 아님), CLOSE(NO_ERROR)를 보낸다. 대기 중인 스트림이 없으므로 곧바로 닫힌다",
      "spec": [
        "2.2.5"
      ],
      "setup": {
        "role": "client",
        "established": true,
        "next_stream_id": 2147483647
      },
      "steps": [
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": 2147483647
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100007fffffff00000000",
          "send": [],
          "events": [
            {
              "event": "result",
              "stream_id": 2147483647,
              "status": "OK"
            }
          ]
        },
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": "CLOSE",
              "error_code": "NO_ERROR"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
