          "send": [
            {
              "type": 257,
              "stream_id": 1
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010200000000000100000000",
          "send": [],
          "events": [
            {
              "event": "result",
              "stream_id": 1,
              "status": "INTERNAL"
            }
          ]
        },
