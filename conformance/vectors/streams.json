    {
      "id": "sender-reset-received-refused",
      "description": "보낸 요청이 RESET(REFUSED)로 끝나면 애플리케이션에 UNAVAILABLE 결과를 넘기고 RESET으로 답하지 않는다. 스트림이 끝났으므로 같은 스트림의 늦은 응답과 RESET은 조용히 버려진다. 결과는 정확히 한 번 나가고 늦은 프레임에는 결과가 다시 나가지 않는다",
      "spec": [
        "4.3",
        "4.4"
      ],
      "setup": {
        "role": "client",
        "established": true
      },
      "steps": [
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": 1
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000040000000000010000000000000003",
          "send": [],
          "events": [
            {
              "event": "result",
              "stream_id": 1,
              "status": "UNAVAILABLE"
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000100000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000040000000000010000000000000003",
          "send": [],
          "events": []
        }
      ]
    },
