    {
      "id": "preface-version-mismatch-closes-silently",
      "description": "연결 서문의 앞 6바이트 중 버전 자리가 다르면(STR1) 서버는 아무것도 보내지 않고 연결을 닫는다. 서문 확인 전이므로 서버 HELLO도 보내지 않는다",
      "spec": [
        "3.1"
      ],
      "setup": {
        "role": "server",
        "established": false
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "c0de5354523100000000000c000100000000000000000000",
          "send": [],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
