    {
      "id": "simultaneous-close-sends-no-second-close",
      "description": "서버 역할 구현이 CLOSE(NO_ERROR)를 보낸 뒤 상대 엔드포인트가 보낸 CLOSE(NO_ERROR)를 받아도 CLOSE로 답하지 않는다. CLOSE를 보냈거나 받은 뒤에는 CLOSE를 보내지 않는다. 서버가 연 스트림 2가 대기 중이라 연결은 열려 있다",
      "spec": [
        "3.5"
      ],
      "setup": {
        "role": "server",
        "established": true
      },
      "steps": [
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": 2
            }
          ],
          "events": []
        },
        {
          "kind": "close",
          "error_code": "NO_ERROR",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "NO_ERROR"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000030000000000000000000000000000",
          "send": [],
          "events": []
        }
      ]
    },
