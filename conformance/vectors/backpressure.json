    {
      "id": "concurrent-streams-return-receiver-response-sent",
      "description": "max_concurrent_streams가 1이고 요청 1이 대기 중이라 n + 1이 한도를 넘는 요청 3은 RESET(REFUSED)로 거절된다. 받은 요청 1에 응답을 보내면 스트림이 끝나 n에서 빠진다. 곧바로 요청 5는 수락되고 요청 7은 다시 거절되므로 반환은 정확히 한 번이다. 응답 뒤에 늦게 온 상대의 RESET(CANCEL)은 조용히 버려진다",
      "spec": [
        "4.3",
        "4.5"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "local_hello": {
          "max_concurrent_streams": 1
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000000c010100000000000100000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 1,
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [
            {
              "type": "RESET",
              "stream_id": 3,
              "error_code": "REFUSED"
            }
          ],
          "events": []
        },
        {
          "kind": "respond",
          "stream_id": 1,
          "status": "OK",
          "send": [
            {
              "type": 257,
              "stream_id": 1,
              "status": "OK"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000040000000000010000000000000004",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000500000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 5,
              "type": 257
            }
          ]
        },
