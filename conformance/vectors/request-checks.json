    {
      "id": "unknown-type-request-is-answered-unimplemented",
      "description": "구현이 아는 type을 257로 좁히고(known_types) 모르는 type(258)의 새 요청을 받으면 연결은 그대로 두고 status = UNIMPLEMENTED로 답한다. 응답의 type은 요청과 같다. 요청은 애플리케이션에 전달하지 않으며, 이어 온 아는 type의 요청은 수락한다",
      "spec": [
        "4.1",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "known_types": [
          257
        ]
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000000c010200000000000100000000",
          "send": [
            {
              "type": 258,
              "stream_id": 1,
              "status": "UNIMPLEMENTED"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 3,
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "000000140002000000000000000000000102030405060708",
          "send": [
            {
              "type": "PING",
              "flags": [
                "ACK"
              ],
              "payload": "0102030405060708"
            }
          ],
          "events": []
        }
      ]
    },
