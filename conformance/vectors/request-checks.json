{
  "format": 1,
  "vectors": [
    {
      "id": "timeout-length-three-is-invalid-argument",
      "description": "요청의 timeout 확장 항목 길이가 4가 아니면(3) 연결은 그대로 두고 status = INVALID_ARGUMENT로 답한다. 요청은 애플리케이션에 전달하지 않는다. 연결이 유지되어 다음 요청 3은 수락한다",
      "spec": [
        "2.4.2",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": true
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001301010000000000010007000000010003000001",
          "send": [
            {
              "type": 257,
              "stream_id": 1,
              "status": "INVALID_ARGUMENT"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c010100000000000300000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 3,
              "type": 257
            }
          ]
        }
      ]
    },
