    {
      "id": "limit-refusal-precedes-unknown-type",
      "description": "동시 스트림 수 한도(1)에 걸리는 새 요청은 type을 보기 전에 거절한다. 대기 중인 요청 1이 있을 때 모르는 type의 요청 3은 RESET(REFUSED)로 거절된다",
      "spec": [
        "4.5",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "local_hello": {
          "max_concurrent_streams": 1
        },
        "known_types": [
          257
        ]
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000000c010100000000000100000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": 1,
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "0000000c010200000000000300000000",
          "send": [
            {
              "type": "RESET",
              "stream_id": 3,
              "error_code": "REFUSED"
            }
          ],
          "events": []
        }
      ]
    },
