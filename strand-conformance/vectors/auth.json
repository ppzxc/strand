    {
      "id": "server-auth-wait-times-out-closes-unauthenticated",
      "description": "서버가 상대 HELLO에 ACK를 보낸 때부터 AUTH 대기 시간(auth_timeout_ms)이 지나도록 AUTH를 받지 못하면 CLOSE(UNAUTHENTICATED)를 보내고 닫는다. 한도 직전에는 아무것도 보내지 않는다",
      "spec": [
        "3.3"
      ],
      "setup": {
        "role": "server",
        "established": false,
        "config": {
          "auth_timeout_ms": 1000
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "c0de535452300000",
          "send": [
            {
              "type": "HELLO"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010000000000000000000000000000",
          "send": [
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "advance",
          "ms": 999,
          "send": [],
          "events": []
        },
        {
          "kind": "advance",
          "ms": 2,
          "send": [
            {
              "type": "CLOSE",
              "error_code": "UNAUTHENTICATED",
              "last_stream_id": "0"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
