    {
      "id": "client-auth-passes-and-gate-opens",
      "description": "클라이언트는 서버 HELLO에 ACK를 보낸 직후 setup.auth의 메커니즘과 자격 증명으로 AUTH를 보낸다. 서버의 AUTH(ACK)를 받은 뒤에야 애플리케이션 요청이 나간다",
      "spec": [
        "3.3",
        "3.3.1"
      ],
      "setup": {
        "role": "client",
        "established": false,
        "auth": {
          "mechanism": "PLAIN",
          "credentials": "0075736572007077"
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001000010000000000000000000000000000",
          "send": [
            {
              "type": "PREFACE"
            },
            {
              "type": "HELLO"
            },
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            },
            {
              "type": "AUTH",
              "mechanism": "PLAIN",
              "credentials": "0075736572007077"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000050100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": "1"
            }
          ],
          "events": []
        }
      ]
    },
    {
      "id": "client-auth-ack-ignores-unknown-identifier",
      "description": "AUTH(ACK)에 credential_lifetime(0x0001)과 모르는 identifier(0x00ff)가 함께 있어도 모르는 것은 무시하고 AUTH 관문을 통과한다. 이어 애플리케이션 요청이 나간다",
      "spec": [
        "3.3",
        "3.3.1"
      ],
      "setup": {
        "role": "client",
        "established": false
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001000010000000000000000000000000000",
