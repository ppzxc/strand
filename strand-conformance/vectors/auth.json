            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001e0005000000000000000000000000000005504c41494e0075736572007077",
          "send": [
            {
              "type": "AUTH",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
