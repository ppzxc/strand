            {
              "type": "PREFACE"
            },
            {
              "type": "HELLO"
            },
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            },
            {
              "type": "AUTH",
              "mechanism": "ANONYMOUS"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001c0005010000000000000000000000000000010000012c00ff00000001",
          "send": [],
          "events": []
        },
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": "1"
            }
          ],
          "events": []
        }
      ]
    },
    {
