{
  "format": 2,
  "vectors": [
    {
      "id": "server-auth-anonymous-passes-and-gate-opens",
      "description": "서버가 기본 설정(ANONYMOUS, 빈 자격 증명)과 같은 AUTH를 받으면 AUTH(ACK)로 답해 AUTH 관문이 열린다. 관문이 열린 뒤에는 PING에 ACK로 답한다",
      "spec": [
        "3.3",
        "3.3.1"
      ],
      "setup": {
        "role": "server",
        "established": false
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "c0de535452300000",
          "send": [
            {
              "type": "HELLO"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010000000000000000000000000000",
          "send": [
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001a0005000000000000000000000000000009414e4f4e594d4f5553",
          "send": [
            {
              "type": "AUTH",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "00000018000200000000000000000000000000000102030405060708",
          "send": [
            {
              "type": "PING",
              "flags": [
                "ACK"
              ],
              "payload": "0102030405060708"
            }
          ],
          "events": []
        }
      ]
    },
    {
      "id": "server-auth-with-credentials-passes",
      "description": "서버가 setup.auth에 설정된 메커니즘과 자격 증명(PLAIN)과 같은 AUTH를 받으면 AUTH(ACK)로 답한다. 관문이 열린 뒤에는 애플리케이션 요청을 받아 애플리케이션에 전달한다",
      "spec": [
        "3.3",
        "3.3.1"
      ],
