{
  "format": 2,
  "vectors": [
    {
      "id": "reset-payload-empty-closes",
      "description": "RESET의 payload가 정확히 4바이트가 아니면(0바이트) 연결 오류다. 대기 중이 아닌 스트림을 가리켜도 조용히 버리지 않고 CLOSE(PROTOCOL_ERROR)를 보낸다",
      "spec": [
        "4.4",
        "5.1"
      ],
      "requirements": [
        "req-reset-payload-length-error",
        "req-check-connection-error-close"
      ],
      "setup": {
        "role": "server",
        "established": true
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001000040000000000000000000100000000",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "PROTOCOL_ERROR",
              "last_stream_id": "0"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
