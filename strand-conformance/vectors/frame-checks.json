    {
      "id": "own-close-ends-queued-request-without-stream-id",
      "description": "AUTH 관문이 열리기 전이라 번호를 받지 못하고 미뤄진 요청은 내가 CLOSE를 보내면 그 즉시 stream_id 없는 UNAVAILABLE(처리 안 됨)로 끝난다",
      "spec": [
        "3.5",
        "4.4"
      ],
      "requirements": [
        "req-close-queued-requests-unavailable-send"
      ],
      "setup": {
        "role": "client",
        "established": false
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001000010000000000000000000000000000",
          "send": [
            {
              "type": "PREFACE"
            },
            {
              "type": "HELLO"
            },
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            },
            {
              "type": "AUTH",
              "mechanism": "ANONYMOUS"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000001000010100000000000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "request",
          "type": 257,
          "send": [],
          "events": []
        },
        {
          "kind": "close",
          "error_code": "NO_ERROR",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "NO_ERROR",
              "last_stream_id": "0"
            }
          ],
          "events": [
            {
              "event": "result",
              "status": "UNAVAILABLE",
              "certainty": "not_processed"
            },
            {
              "event": "closed"
            }
          ]
        }
      ]
    },
