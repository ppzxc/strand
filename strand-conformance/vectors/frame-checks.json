    {
      "id": "ping-undefined-flag-bits-are-ignored",
      "description": "ACK가 없는 PING에 정의되지 않은 flags 비트(0x82)가 켜져 있어도 오류가 아니다. 그 비트는 무시하고 ACK PING으로 답한다",
      "spec": [
        "2.2.3",
        "3.4"
      ],
      "requirements": [
        "req-flags-undefined-ignore-recv"
      ],
      "setup": {
        "role": "server",
        "established": true
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "00000018000282000000000000000000000000000102030405060708",
          "send": [
            {
              "type": "PING",
              "flags": [
                "ACK"
              ],
              "payload": "0102030405060708"
            }
          ],
          "events": []
        }
      ]
    },
    {
      "id": "ack-ping-undefined-flag-bits-are-ignored",
      "description": "기다리던 ACK PING에 정의되지 않은 flags 비트가 함께 켜져 있어도(0x03) ACK로 받아들인다. 확인 대기가 취소되어 시계가 더 지나도 CLOSE를 보내지 않는다",
      "spec": [
        "2.2.3",
        "3.3",
        "3.4"
      ],
      "requirements": [
        "req-flags-undefined-ignore-recv"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "config": {
          "ack_timeout_ms": 1000
        }
      },
      "steps": [
        {
          "kind": "ping",
          "payload": "0102030405060708",
          "send": [
            {
              "type": "PING",
              "payload": "0102030405060708"
            }
          ],
          "events": []
        },
        {
          "kind": "advance",
          "ms": 999,
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "00000018000203000000000000000000000000000102030405060708",
          "send": [],
          "events": []
        },
        {
          "kind": "advance",
          "ms": 5000,
          "send": [],
          "events": []
        }
      ]
    },
