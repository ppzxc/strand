    {
      "id": "reset-flags-are-ignored",
      "description": "RESET의 flags는 모두 미정의이므로 켜져 있어도 무시한다. max_concurrent_streams가 1일 때 요청 1을 flags 0xFF인 RESET으로 끝내면 그 자리가 반환되어 요청 3을 다시 수락한다",
      "spec": [
        "2.3",
        "4.3",
        "4.5"
      ],
      "setup": {
        "role": "server",
        "established": true,
        "local_hello": {
          "max_concurrent_streams": 1
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "0000001001010000000000000000000100000000",
          "send": [],
          "events": [
            {
              "event": "request_received",
              "stream_id": "1",
              "type": 257
            }
          ]
        },
        {
          "kind": "recv",
          "hex": "000000140004ff0000000000000000010000000000000004",
          "send": [],
          "events": []
