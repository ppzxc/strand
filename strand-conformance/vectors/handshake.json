{
  "format": 1,
  "vectors": [
    {
      "id": "postack-frame-above-announced-limit-closes",
      "description": "서버는 자기가 알린 max_frame_size(16,384)로 length를 언제나 검사한다. 클라이언트 ACK를 받은 뒤 length가 16,396(알린 한도 − 4 = 16,380 초과, 전체 16,400바이트)인 프레임이 오면 연결 오류이고 CLOSE(PROTOCOL_ERROR)를 보낸다",
      "spec": [
        "2.2.1",
        "5.1"
      ],
      "setup": {
        "role": "server",
        "established": false,
        "local_hello": {
          "max_frame_size": 16384
        }
      },
      "steps": [
        {
          "kind": "recv",
          "hex": "c0de535452300000",
          "send": [
            {
              "type": "HELLO",
              "params": {
                "max_frame_size": 16384
              }
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c000100000000000000000000",
          "send": [
            {
              "type": "HELLO",
              "flags": [
                "ACK"
              ]
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "0000000c000101000000000000000000",
          "send": [],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "",
          "send": [
            {
              "type": "CLOSE",
              "error_code": "PROTOCOL_ERROR"
            }
          ],
          "events": [
            {
              "event": "closed"
            }
          ]
        }
      ]
    }
  ]
}
