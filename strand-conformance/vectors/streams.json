      "steps": [
        {
          "kind": "request",
          "type": 257,
          "send": [
            {
              "type": 257,
              "stream_id": "9223372036854775807"
            }
          ],
          "events": []
        },
        {
          "kind": "recv",
          "hex": "00000010010100007fffffffffffffff00000000",
          "send": [],
