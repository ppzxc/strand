<?xml version="1.0" encoding="UTF-8"?>
<!-- strand 빌드와 분리된 외부 소비자. 입력은 -DstrandVersion(필수, 배포 버전이자 기대 버전)과 -DrepoUrl(기본 Central)이다. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>strand.deploytest</groupId>
  <artifactId>strand-deploy-test-classpath</artifactId>
  <version>1</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <repoUrl>https://repo.maven.apache.org/maven2</repoUrl>
    <!-- 기본적으로 받아 온 버전이다. 비교 경로 자체를 시험할 때만 -DexpectedVersion, -DexpectedNioVersion, -DexpectedNettyVersion으로 덮어쓴다. -->
    <expectedVersion>${strandVersion}</expectedVersion>
    <expectedNioVersion>${strandVersion}</expectedNioVersion>
    <expectedNettyVersion>${strandVersion}</expectedNettyVersion>
  </properties>

  <!-- 원격 모드에서 strand-core, strand-nio, strand-netty가 이 저장소에서 왔는지는 run.sh가 _remote.repositories로 확인한다. -->
  <repositories>
    <repository>
      <id>strand-input</id>
      <url>${repoUrl}</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.github.ppzxc</groupId>
      <artifactId>strand-core</artifactId>
      <version>${strandVersion}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ppzxc</groupId>
      <artifactId>strand-nio</artifactId>
      <version>${strandVersion}</version>
    </dependency>
    <dependency>
      <groupId>io.github.ppzxc</groupId>
      <artifactId>strand-netty</artifactId>
      <version>${strandVersion}</version>
    </dependency>
    <!-- strand-netty는 Netty를 compileOnlyApi로 의존해 POM에 싣지 않는다. 소비자가 Netty를 직접 의존한다. -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport</artifactId>
      <version>4.1.141.Final</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>../shared/src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <fork>true</fork>
          <release>11</release>
          <compilerArgs>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xlint:all</arg>
            <arg>-Xplugin:ErrorProne -Xep:ArrayEquals:ERROR -Xep:ArrayToString:ERROR -Xep:EqualsIncompatibleType:ERROR -Xep:EqualsHashCode:ERROR -Xep:ModifyCollectionInEnhancedForLoop:ERROR -Xep:ModifySourceCollectionInStream:ERROR -Xep:NarrowCalculation:ERROR -Xep:NarrowingCompoundAssignment:ERROR</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>2.52.0</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>consumer-dependency-allowlist</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes><exclude>*:*</exclude></excludes>
                  <includes>
                    <include>io.github.ppzxc:strand-core</include>
                    <include>io.github.ppzxc:strand-nio</include>
                    <include>io.github.ppzxc:strand-netty</include>
                    <include>io.github.ppzxc:strand-api</include>
                    <include>io.netty:netty-transport</include>
                    <include>io.netty:netty-common</include>
                    <include>io.netty:netty-buffer</include>
                    <include>io.netty:netty-resolver</include>
                    <include>org.jspecify:jspecify</include>
                    <include>com.google.errorprone:error_prone_annotations</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>strand.deploytest.Main</argument>
            <argument>${expectedVersion}</argument>
            <argument>${expectedNioVersion}</argument>
            <argument>${expectedNettyVersion}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
